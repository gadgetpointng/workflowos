{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "ignoreCommand": "if [ \"${VERCEL_PROJECT_ID:-}\" = \"prj_HgZVEKJh7Xqsl1xyv4cTgZ92BgIH\" ]; then exit 0; fi; exit 1",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/operations",
      "schedule": "0 6 * * *"
    }
  ]
}
