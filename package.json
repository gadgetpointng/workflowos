{
  "name": "workflowos",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-internal-links.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "check:launch": "node scripts/launch-check.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs && node scripts/check-gadgetpoint-auth-boundary.mjs",
    "check:notifications": "node scripts/check-notification-gates.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:release": "npm run check:boundaries && npm run check:notifications && npm run check:links && npm run check:launch"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "openai": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/postcss": "latest",
    "postcss": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest"
  }
}
